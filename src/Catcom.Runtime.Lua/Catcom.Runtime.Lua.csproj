<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>Catcom.Runtime.Lua</AssemblyName>
        <RootNamespace>Catcom.Runtime.Lua</RootNamespace>
        <Description>LuaJIT script runtime adapter (LibraryImport bindings to the shipped lua51 native).</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Catcom.Core\Catcom.Core.csproj" />
    </ItemGroup>

    <!-- Natives installed by tools/fetch-natives.* (cross-built by CI with tools/build-natives.sh) land in
         runtimes/<rid>/native/ (gitignored); the marker files stay out of the output. -->
    <ItemGroup>
        <None Include="runtimes/**" Exclude="runtimes/.gitignore;runtimes/**/.luajit-commit;runtimes/**/.ksa-natives" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Runtime-private sandbox bootstrap, and the script-facing prelude (Core's shared ksa.lua when it
         exists, otherwise the placeholder prelude shipped with this project). -->
    <ItemGroup>
        <EmbeddedResource Include="Bootstrap\bootstrap.lua" LogicalName="Catcom.Runtime.Lua.bootstrap.lua" />
        <EmbeddedResource Include="..\Catcom.Core\Api\Preludes\ksa.lua" LogicalName="Catcom.Runtime.Lua.ksa.lua" Condition="Exists('..\Catcom.Core\Api\Preludes\ksa.lua')" />
        <EmbeddedResource Include="Prelude\ksa.placeholder.lua" LogicalName="Catcom.Runtime.Lua.ksa.lua" Condition="!Exists('..\Catcom.Core\Api\Preludes\ksa.lua')" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Catcom.Runtime.Lua.Tests" />
    </ItemGroup>

</Project>
