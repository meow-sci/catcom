<Project Sdk="Microsoft.NET.Sdk">

    <!-- Build vehicle for the deployable mod folder: contains no code of its own (DistMarker.cs only
         gives the SDK something to compile). Building it builds Catcom.GameMod and
         Catcom.PurrTty and lays the whole mod out in $(CatcomDistDir). -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>Catcom.Dist</AssemblyName>
        <RootNamespace>Catcom.Dist</RootNamespace>
        <Description>Deploys the catcom mod folder (Catcom.GameMod, Catcom.PurrTty, natives, assets, libraries).</Description>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Copies every transitive NuGet dependency (ClearScript, MessagePack, Tomlyn, ...) to $(TargetDir). -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <DistDir>$(CatcomDistDir)</DistDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Catcom.GameMod\Catcom.GameMod.csproj" />
        <ProjectReference Include="..\Catcom.PurrTty\Catcom.PurrTty.csproj" />
    </ItemGroup>

    <!-- Deploys the complete mod folder to $(DistDir) on every build (mirrors gatOS's / purrTTY's
         CopyCustomContent). CatcomDistDir resolves in Directory.Build.props:
         CATCOM_DIST_DIR override (CI zips it; it is the FULL dist folder), else
         <KSAUserDir>mods/catcom/.

         This project exists so the deploy sees BOTH mod assemblies and all their transitive copy-local
         items: Catcom.GameMod (the StarMap entry assembly) and Catcom.PurrTty (the only assembly
         that references purrTTY types; GameMod loads it by path, see PurrTtyBridge). Neither project depends
         on the other, so neither could host the target. -->
    <!-- Every binary the dist must always contain, for every platform, whatever host builds it. They are
         fetched (never committed) by tools/fetch-all.sh / tools/fetch-all.ps1: the TypeScript assets, and per
         platform the LuaJIT library and tree-sitter parser (cross-built by CI, tools/fetch-natives.*), the
         ClearScript V8 native (NuGet), Neovim and the two language servers (tools/fetch-nvim.*, fetch-lsp.*).
         A missing file fails the build: a dist is never produced without all of them. -->
    <ItemGroup>
        <DistGameRid Include="win-x64">
            <Exe>.exe</Exe>
            <LuaLib>lua51.dll</LuaLib>
            <ParserExt>dll</ParserExt>
            <V8Native>ClearScriptV8.win-x64.dll</V8Native>
        </DistGameRid>
        <DistGameRid Include="linux-x64">
            <Exe></Exe>
            <LuaLib>libluajit-5.1.so.2</LuaLib>
            <ParserExt>so</ParserExt>
            <V8Native>ClearScriptV8.linux-x64.so</V8Native>
        </DistGameRid>
        <DistGameRid Include="osx-arm64">
            <Exe></Exe>
            <LuaLib>libluajit-5.1.2.dylib</LuaLib>
            <ParserExt>dylib</ParserExt>
            <V8Native>ClearScriptV8.osx-arm64.dylib</V8Native>
        </DistGameRid>
    </ItemGroup>

    <!-- Runs before the old dist is touched, so a failed check never leaves a half-wiped mod folder. -->
    <Target Name="CheckDistPayload">
        <ItemGroup>
            <DistRequiredFile Include="$(TargetDir)assets/typescript.js;$(TargetDir)assets/sucrase.bundle.js" />
            <DistRequiredFile Include="$(TargetDir)runtimes/%(DistGameRid.Identity)/native/%(DistGameRid.LuaLib)" />
            <DistRequiredFile Include="$(TargetDir)runtimes/%(DistGameRid.Identity)/native/%(DistGameRid.V8Native)" />
            <DistRequiredFile Include="$(RepoRoot)editor/%(DistGameRid.Identity)/nvim/bin/nvim%(DistGameRid.Exe)" />
            <DistRequiredFile Include="$(RepoRoot)editor/%(DistGameRid.Identity)/nvim/lib/nvim/parser/typescript.%(DistGameRid.ParserExt)" />
            <DistRequiredFile Include="$(RepoRoot)editor/%(DistGameRid.Identity)/lsp/lua-language-server/bin/lua-language-server%(DistGameRid.Exe)" />
            <DistRequiredFile Include="$(RepoRoot)editor/%(DistGameRid.Identity)/lsp/typescript/lib/tsc%(DistGameRid.Exe)" />
            <DistMissingFile Include="@(DistRequiredFile)" Condition="!Exists('%(DistRequiredFile.Identity)')" />
        </ItemGroup>
        <Error Condition="'@(DistMissingFile)' != ''"
               Text="catcom dist: @(DistMissingFile->Count()) required binaries are missing, so no dist was produced. Run tools/fetch-all.sh (macOS/Linux) or tools/fetch-all.ps1 (Windows) once, then build again. Missing:%0A  @(DistMissingFile, '%0A  ')" />
        <Message Importance="High" Text="catcom dist: all @(DistRequiredFile->Count()) required binaries present (3 platforms)" />
    </Target>

    <!-- Without the KSA reference assemblies GameMod and PurrTty compile to empty shells, so no dist is
         deployed at all (a loud message, never a broken mod folder). -->
    <Target Name="DistSkipped" AfterTargets="AfterBuild" Condition="'$(KsaAssembliesPresent)' != 'true'">
        <Message Importance="High" Text="catcom dist: SKIPPED, the KSA reference assemblies were not found (KSAFolder='$(KSAFolder)'; set KSA_DLL_DIR or clone ksa-game-assemblies next to this repo)." />
    </Target>

    <Target Name="CopyCustomContent" AfterTargets="AfterBuild" DependsOnTargets="CheckDistPayload" Condition="'$(KsaAssembliesPresent)' == 'true'">

        <!-- Wipe the managed payload (top-level files) and the folders that are 100% build output
             (third-party-licenses, runtimes, scripts-lib) so a redeploy never leaves stale DLLs from
             a previous version in the game's mod ALC. User data is deliberately NOT touched:
               catcom.toml, bindings.toml, terminals.toml  (excluded from the top-level wipe)
               scripts/                                           (the user's scripts; never wiped)
               editor/                                            (fetched nvim/LSP blobs are large and
                                                                   content-stable; they are copied with
                                                                   SkipUnchangedFiles instead of wiped)
             On Windows the install dir and the runtime data dir are the same folder, so the live
             config and the user's scripts live here. -->
        <ItemGroup>
            <StaleDistFile Include="$(DistDir)*" Exclude="$(DistDir)catcom.toml;$(DistDir)bindings.toml;$(DistDir)terminals.toml"/>
        </ItemGroup>
        <Delete Files="@(StaleDistFile)"/>
        <RemoveDir Directories="$(DistDir)third-party-licenses;$(DistDir)runtimes;$(DistDir)scripts-lib;$(DistDir)assets"/>
        <MakeDir Directories="$(DistDir)"/>

        <!-- mod.toml (from the source of truth) + the ENTRY assembly's deps.json (StarMap's
             ModAssemblyLoadContext resolves the mod's own dependencies through an
             AssemblyDependencyResolver, which reads <entry assembly>.deps.json — so it must be GameMod's,
             not this project's). GetTargetPath yields GameMod's output DLL; the deps.json sits next to it.
             Catcom.PurrTty.dll needs no deps.json entry: GameMod loads it by file path. -->
        <MSBuild Projects="../Catcom.GameMod/Catcom.GameMod.csproj" Targets="GetTargetPath">
            <Output TaskParameter="TargetOutputs" PropertyName="GameModTargetPath"/>
        </MSBuild>
        <PropertyGroup>
            <GameModDepsFile>$([System.IO.Path]::ChangeExtension('$(GameModTargetPath)', '.deps.json'))</GameModDepsFile>
        </PropertyGroup>
        <Copy SourceFiles="$(RepoRoot)src/Catcom.GameMod/mod.toml" DestinationFolder="$(DistDir)" Condition="Exists('$(RepoRoot)src/Catcom.GameMod/mod.toml')"/>
        <Copy SourceFiles="$(GameModDepsFile)" DestinationFolder="$(DistDir)" Condition="'$(GameModTargetPath)' != '' AND Exists('$(GameModDepsFile)')"/>
        <Error Condition="'$(GameModTargetPath)' == '' OR !Exists('$(GameModDepsFile)')"
               Text="Catcom.GameMod.deps.json was not found next to the GameMod output ('$(GameModTargetPath)'); StarMap cannot resolve the mod's dependencies without it."/>

        <!-- Managed payload: everything in the build output EXCEPT the loader-supplied
             assemblies (StarMap provides 0Harmony + StarMap.API to every mod ALC; shipping a
             second copy risks type-identity splits). Their package references are compile-only
             (ExcludeAssets=runtime), so they never reach the output; the deny-list entries are a
             backstop against a future reference that brings them in. The KSA reference assemblies never reach
             the output (Private=false). A glob with a deny-list — rather than an allow-list —
             means a newly added NuGet dependency ships automatically instead of failing at
             runtime in-game. Includes Catcom.GameMod.dll and Catcom.PurrTty.dll.
             The vendored purrTTY contract DLLs (purrTTY.*.dll) must NEVER ship: they are compile-only
             references, and a local copy would be loaded instead of purrTTY's, splitting type identity.
             This project's own assembly (Catcom.Dist.dll) is an empty build vehicle and is denied
             too. Game assemblies that MSBuild copy-locals as transitive dependencies of the
             Private=false KSA references (Brutal.Core.Collections, Brutal.Core.Memory,
             CommunityToolkit.HighPerformance, …) are game-provided and must never ship (a second
             copy splits type identity), so they are denied here too. -->
        <ItemGroup>
            <ModManagedDll Include="$(TargetDir)*.dll"
                           Exclude="$(TargetDir)0Harmony.dll;$(TargetDir)StarMap.API.dll;$(TargetDir)purrTTY.*.dll;$(TargetDir)Catcom.Dist.dll;$(TargetDir)KSA.dll;$(TargetDir)Brutal.*.dll;$(TargetDir)Planet.*.dll;$(TargetDir)Bepu*.dll;$(TargetDir)CommunityToolkit.HighPerformance.dll;$(TargetDir)imgui.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(ModManagedDll)" DestinationFolder="$(DistDir)" Condition="'@(ModManagedDll)' != ''"/>

        <!-- Native libraries: ClearScript V8 natives (NuGet) and the LuaJIT shared library
             (src/Catcom.Runtime.Lua/runtimes/<rid>/native/, built by tools/build-luajit.*)
             flow into $(TargetDir)runtimes/<rid>/native/ and are resolved by the .NET native
             probing (deps.json) relative to the mod folder. -->
        <ItemGroup>
            <NativeFile Include="$(TargetDir)runtimes/**/*" Exclude="$(TargetDir)runtimes/**/.gitignore"/>
        </ItemGroup>
        <Copy SourceFiles="@(NativeFile)" DestinationFolder="$(DistDir)runtimes/%(RecursiveDir)" Condition="'@(NativeFile)' != ''"/>

        <!-- V8 runtime assets (typescript.js, sucrase bundle + licences; fetched by tools/fetch-ts.*
             into src/Catcom.Runtime.V8/assets/ and copied to $(TargetDir)assets/). -->
        <ItemGroup>
            <V8AssetFile Include="$(TargetDir)assets/**/*" Exclude="$(TargetDir)assets/**/.gitignore"/>
        </ItemGroup>
        <Copy SourceFiles="@(V8AssetFile)" DestinationFolder="$(DistDir)assets/%(RecursiveDir)" Condition="'@(V8AssetFile)' != ''"/>

        <!-- Shipped script libraries (scripts-lib/): copied to <user>/scripts/lib on every start. -->
        <ItemGroup>
            <ScriptsLibFile Include="$(RepoRoot)scripts-lib/**/*"/>
        </ItemGroup>
        <Copy SourceFiles="@(ScriptsLibFile)" DestinationFolder="$(DistDir)scripts-lib/%(RecursiveDir)" Condition="'@(ScriptsLibFile)' != ''"/>

        <!-- Editor payload (NOT wiped, see the wipe note). Small repo-owned files are always refreshed; the
             fetched per-RID blobs (tools/fetch-nvim.*, fetch-lsp.*, fetch-natives.*; gitignored) use
             SkipUnchangedFiles to keep the per-build deploy cost near zero. Their presence was verified by
             CheckDistPayload. -->
        <ItemGroup>
            <EditorConfigFile Include="$(RepoRoot)editor/config/**/*"/>
            <EditorStubFile Include="$(RepoRoot)editor/noshell*"/>
            <EditorStubFile Include="$(RepoRoot)editor/*.json"/>
            <EditorWinX64File Include="$(RepoRoot)editor/win-x64/**/*"/>
            <EditorLinuxX64File Include="$(RepoRoot)editor/linux-x64/**/*"/>
            <EditorOsxArm64File Include="$(RepoRoot)editor/osx-arm64/**/*"/>
        </ItemGroup>
        <Copy SourceFiles="@(EditorConfigFile)" DestinationFolder="$(DistDir)editor/config/%(RecursiveDir)" Condition="'@(EditorConfigFile)' != ''"/>
        <Copy SourceFiles="@(EditorStubFile)" DestinationFolder="$(DistDir)editor/" Condition="'@(EditorStubFile)' != ''"/>
        <Copy SourceFiles="@(EditorWinX64File)" DestinationFolder="$(DistDir)editor/win-x64/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(EditorWinX64File)' != ''"/>
        <Copy SourceFiles="@(EditorLinuxX64File)" DestinationFolder="$(DistDir)editor/linux-x64/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(EditorLinuxX64File)' != ''"/>
        <Copy SourceFiles="@(EditorOsxArm64File)" DestinationFolder="$(DistDir)editor/osx-arm64/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(EditorOsxArm64File)' != ''"/>

        <!-- Licenses (THIRD-PARTY-NOTICES.md carries the redistributed-component obligations;
             third-party-licenses/ holds the full texts). Each is optional so a fresh clone builds. -->
        <Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFolder="$(DistDir)" Condition="Exists('$(RepoRoot)LICENSE')"/>
        <Copy SourceFiles="$(RepoRoot)THIRD-PARTY-NOTICES.md" DestinationFolder="$(DistDir)" Condition="Exists('$(RepoRoot)THIRD-PARTY-NOTICES.md')"/>
        <ItemGroup>
            <ThirdPartyLicenseFile Include="$(RepoRoot)third-party-licenses/*"/>
        </ItemGroup>
        <Copy SourceFiles="@(ThirdPartyLicenseFile)" DestinationFolder="$(DistDir)third-party-licenses/" Condition="'@(ThirdPartyLicenseFile)' != ''"/>
    </Target>

</Project>
