<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>KsaScripting.Runtime.Lua</AssemblyName>
        <RootNamespace>KsaScripting.Runtime.Lua</RootNamespace>
        <Description>LuaJIT script runtime adapter (LibraryImport bindings to the shipped lua51 native).</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\KsaScripting.Core\KsaScripting.Core.csproj" />
    </ItemGroup>

    <!-- Natives built by tools/build-luajit.* land in runtimes/<rid>/native/ (gitignored). -->
    <ItemGroup>
        <None Include="runtimes/**" Exclude="runtimes/.gitignore;runtimes/**/.luajit-commit" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Runtime-private sandbox bootstrap, and the script-facing prelude (Core's shared ksa.lua when it
         exists, otherwise the placeholder prelude shipped with this project). -->
    <ItemGroup>
        <EmbeddedResource Include="Bootstrap\bootstrap.lua" LogicalName="KsaScripting.Runtime.Lua.bootstrap.lua" />
        <EmbeddedResource Include="..\KsaScripting.Core\Api\Preludes\ksa.lua" LogicalName="KsaScripting.Runtime.Lua.ksa.lua" Condition="Exists('..\KsaScripting.Core\Api\Preludes\ksa.lua')" />
        <EmbeddedResource Include="Prelude\ksa.placeholder.lua" LogicalName="KsaScripting.Runtime.Lua.ksa.lua" Condition="!Exists('..\KsaScripting.Core\Api\Preludes\ksa.lua')" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="KsaScripting.Runtime.Lua.Tests" />
    </ItemGroup>

</Project>
