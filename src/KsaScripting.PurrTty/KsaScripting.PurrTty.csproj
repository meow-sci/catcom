<Project Sdk="Microsoft.NET.Sdk">

    <!-- The ONLY assembly that references purrTTY types: the custom shells (ScriptTerminalShell,
         ScriptReplShell) and the launcher bridge (PurrTtyBridgeImpl). KsaScripting.GameMod, the StarMap
         entry assembly, has no compile-time reference to this project's output and no purrTTY types in any
         type definition: some StarMap builds call GetTypes() on the entry assembly BEFORE the dependency
         wiring (mod.toml ImportedAssemblies) exists, and a type whose definition needs a purrTTY type would
         then resolve the contract through this mod's own deps.json and split the type identity.
         GameMod loads KsaScripting.PurrTty.dll by file path (PurrTtyBridge.TryLoad), only when purrTTY is a
         loaded mod, at which point the wiring exists and the contract resolves to purrTTY's copy.
         Shipped by KsaScripting.Dist next to KsaScripting.GameMod.dll. -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>KsaScripting.PurrTty</AssemblyName>
        <RootNamespace>KsaScripting.PurrTty</RootNamespace>
        <Description>The purrTTY side of ksa-scripting: custom shells (script terminal, REPLs) and the terminal launcher bridge.</Description>
        <Product>ksa-scripting</Product>
        <Company>meow sci</Company>
        <Copyright>Copyright © meow sci</Copyright>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Compiles only when the KSA reference assemblies are present (it consumes the game-coupled
         KsaScripting.GameMod); CI without the private game DLLs builds an empty assembly. -->
    <ItemGroup Condition="'$(KsaAssembliesPresent)' != 'true'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KsaScripting.GameMod\KsaScripting.GameMod.csproj" />
    </ItemGroup>

    <!-- Vendored purrTTY contract: COMPILE-ONLY (Private=false). Never copied to the output or listed in a
         deps.json: a local copy would be loaded instead of purrTTY's by a StarMap build that resolves the
         bridge's references before the dependency wiring exists, splitting type identity. With purrTTY
         installed, mod.toml ImportedAssemblies resolves both assemblies from purrTTY's load context. -->
    <ItemGroup>
        <Reference Include="purrTTY.CustomShellContract">
            <HintPath>$(RepoRoot)vendor/purrTTY/purrTTY.CustomShellContract.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="purrTTY.Logging">
            <HintPath>$(RepoRoot)vendor/purrTTY/purrTTY.Logging.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
