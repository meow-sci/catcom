<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <!-- Keep in sync with src/KsaScripting.GameMod/mod.toml `version`. -->
        <Version>0.1.0</Version>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Zero-warning policy: MSBuild-level warnings (e.g. MSB3277 reference-version
             conflicts) are errors too, not just compiler (CS) warnings. -->
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors/>
        <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>TRACE</DefineConstants>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <!--
        ===== KSA game paths =====

        RepoRoot — this repo's root directory (trailing slash). Used by the GameMod dist target
        to reach editor/, scripts-lib/, vendor/ and the license files.

        KSAFolder — directory containing the KSA reference assemblies (KSA.dll,
        Brutal.*.dll, Planet.*.dll) the projects compile against. Always ends in a slash.
        Resolution order, first match wins; every tier works on any host OS:

          1. KSA_DLL_DIR env var (or -p:KSA_DLL_DIR=...). This is what CI uses.
          2. A `ksa-game-assemblies` checkout cloned NEXT TO this repo
             (DLLs in its current/dll/ folder) — clone-and-go, no config.
          3. Per-OS developer defaults (game install on Windows; the
             ksa-game-assemblies checkout on macOS/Linux).

        Only KsaScripting.Ksa, KsaScripting.GameMod and the Ksa.CompileCheck project reference
        these assemblies: the references are condition-guarded and their sources are
        compile-removed when KsaAssembliesPresent is not 'true', so every game-free project
        (Core, the runtimes, their tests) builds even when the KSA DLLs are absent.

        KsaScriptingDistDir — the FULL folder the built mod is deployed to by the GameMod
        project (nothing is appended to it). Override with KSA_SCRIPTING_DIST_DIR (CI zips that
        folder); defaults to <KSAUserDir>mods/ksa-scripting/ (on macOS/Linux that is
        $HOME/repos/meow-sci/mods/ksa-scripting/).

        NOTE: spikes/ has its own Directory.Build.props, which shadows this one for everything
        below spikes/ — it does not inherit any of the properties above.
    -->
    <PropertyGroup>
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(KSA_DLL_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(KSA_DLL_DIR)'))</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND Exists('$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/')">$(MSBuildThisFileDirectory)../ksa-game-assemblies/current/dll/</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(OS)' == 'Windows_NT'">C:\Program Files\Kitten Space Agency\</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == ''">$(HOME)/repos/meow-sci/ksa-game-assemblies/current/dll/</KSAFolder>
        <KSAFolder>$([MSBuild]::EnsureTrailingSlash('$(KSAFolder)'))</KSAFolder>

        <KsaAssembliesPresent Condition="Exists('$(KSAFolder)KSA.dll')">true</KsaAssembliesPresent>

        <!-- mods -->
        <KSAUserDir Condition="'$(KSAUserDir)' == '' AND '$(OS)' == 'Windows_NT'">$(USERPROFILE)\Documents\My Games\Kitten Space Agency\</KSAUserDir>
        <KSAUserDir Condition="'$(KSAUserDir)' == ''">$(HOME)/repos/meow-sci/</KSAUserDir>
        <KSAUserModDir>$(KSAUserDir)mods/</KSAUserModDir>
        <KsaScriptingDistDir Condition="'$(KsaScriptingDistDir)' == '' AND '$(KSA_SCRIPTING_DIST_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(KSA_SCRIPTING_DIST_DIR)'))</KsaScriptingDistDir>
        <KsaScriptingDistDir Condition="'$(KsaScriptingDistDir)' == ''">$(KSAUserModDir)ksa-scripting/</KsaScriptingDistDir>
    </PropertyGroup>
</Project>
